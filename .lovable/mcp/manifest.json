{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vbffeprxfveocgcrdten.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cnt-informatica-mcp",
      "version": "0.1.0",
      "title": "CNT Informática"
    },
    "tools": [
      {
        "name": "list_students",
        "title": "List students",
        "description": "List students the caller can access. Optional name substring filter (case-insensitive). Returns up to 100 rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional substring to match against the student name.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_attendance",
        "title": "Get attendance for a date",
        "description": "Return attendance records for a specific date (YYYY-MM-DD). Optionally filter by student_id. Defaults to today.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date": {
              "description": "ISO date (YYYY-MM-DD). Defaults to today.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "student_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_birthdays",
        "title": "List birthdays for a month",
        "description": "List students whose birthday falls in the given month (1-12). Defaults to the current month.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
